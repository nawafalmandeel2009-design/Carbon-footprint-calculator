/* Custom CSS adjustments to match project wireframes and layout constraints */
body {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background-color: #f8f9fa;
}

h1 {
    color: #2c3e50;
}

.card {
    border-width: 1px;
}

.card-header {
    letter-spacing: 0.5px;
}

/* Enhances button interaction look & feel */
.btn-primary {
    background-color: #0d6efd;
    border-color: #0d6efd;
}

.btn-primary:hover {
    background-color: #0b5ed7;
    border-color: #0a58ca;
}
